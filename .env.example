# Copia este archivo como .env y configura los valores; no subas el .env a Git.
BOT_TOKEN=
TMDB_API_KEY=
OMDB_API_KEY=
GROUP_CHAT_ID=-1001234567890
# Opcional: ID del chat privado/grupo que recibe avisos de fallos repetidos.
ADMIN_CHAT_ID=
# Opcional: sin esta variable se habilitan las seis fuentes HTML oficiales.
# WEB_SOURCES=telemundo,las_estrellas,caracol,rtve,globoplay,atresplayer
# WEB_SOURCES=none desactiva solo la nueva capa HTML.
