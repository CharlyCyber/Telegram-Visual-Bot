# Copia este archivo como .env y configura los valores; no subas el .env a Git.
BOT_TOKEN=
TMDB_API_KEY=
OMDB_API_KEY=
GROUP_CHAT_ID=
# Opcional: ID del chat privado/grupo que recibe avisos de fallos repetidos.
ADMIN_CHAT_ID=
# Opcional: URL pública externa para auto-ping 24/7 (Render/HF Spaces la detectan automáticamente).
# PUBLIC_URL=https://tu-servicio.onrender.com
# SELF_PING_INTERVAL=300
# Opcional: sin esta variable se habilitan las siete fuentes HTML oficiales.
# WEB_SOURCES=telemundo,las_estrellas,caracol,rtve,globoplay,atresplayer,mediaset
# WEB_SOURCES=none desactiva solo la capa HTML.
